<Window x:Class="PokerCompanion.App.OverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Poker Companion - manual chart result" Width="340" Height="200" MinWidth="280" MinHeight="150" Topmost="True" ResizeMode="CanResize" Background="#172033" Foreground="White">
  <StackPanel Margin="16">
    <TextBlock Text="MANUAL CHART RESULT" FontSize="12" Foreground="#A7BDDB"/>
    <TextBlock Text="{Binding Hand}" Margin="0,6,0,4" FontSize="20"/>
    <TextBlock Text="{Binding Action}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>
    <TextBlock Text="Updates from your manual selections. Drag the title bar to move." Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#A7BDDB"/>
  </StackPanel>
</Window>
