<Window x:Class="PokerCompanion.App.OverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Poker Companion - detected hand and chart" Width="360" Height="260" MinWidth="280" MinHeight="220" Topmost="True" ResizeMode="CanResize" Background="#172033" Foreground="White">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
    <TextBlock Text="DETECTED CARDS" FontSize="12" Foreground="#A7BDDB"/>
    <TextBlock Text="{Binding RecognizedCards}" Margin="0,6,0,4" FontSize="20" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding RecognitionStatus}" TextWrapping="Wrap" FontSize="12" Foreground="#A7BDDB"/>
    <TextBlock Text="{Binding PositionStatus}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="14"/>
    <TextBlock Text="CHART LOOKUP — MANUAL SCENARIO" Margin="0,12,0,4" FontSize="12" Foreground="#A7BDDB"/>
    <TextBlock Text="{Binding Hand}" FontSize="16"/>
    <TextBlock Text="{Binding Action}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>
  </StackPanel></ScrollViewer>
</Window>
