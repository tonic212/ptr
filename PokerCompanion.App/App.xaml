<Application x:Class="PokerCompanion.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:services="clr-namespace:PokerCompanion.App.Services" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <services:ChartImageConverter x:Key="ChartImageConverter"/>
    <Style TargetType="Button"><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,8,8"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,0,12"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="0,4,0,12"/></Style>
  </Application.Resources>
</Application>
